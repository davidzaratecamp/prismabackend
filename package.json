{
  "name": "prisma-backend",
  "version": "1.0.0",
  "description": "Prisma — Gestor de proyectos y módulos de desarrollo (Asiste Ing)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:create": "node scripts/create-db.js",
    "migrate": "knex migrate:latest --knexfile knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile knexfile.js",
    "seed": "knex seed:run --knexfile knexfile.js",
    "seed:demo": "cross-env SEED_DEMO=1 knex seed:run --knexfile knexfile.js && node scripts/recompute-all.js",
    "recompute": "node scripts/recompute-all.js",
    "retell:sync": "node scripts/retell-sync.js",
    "db:reset": "npm run migrate:rollback && npm run migrate && npm run seed",
    "db:reset:demo": "npm run migrate:rollback && npm run migrate && npm run seed:demo"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "morgan": "^1.12.0",
    "mysql2": "^3.24.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14"
  }
}
