# Copia este archivo a .env y ajusta los valores
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Base de datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=prisma_db

# Autenticación
JWT_SECRET=pon-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Credenciales del admin sembrado (solo se usan en el seed inicial)
SEED_ADMIN_NAME=Anderson Zarate
SEED_ADMIN_EMAIL=dev2@asisteing.com
SEED_ADMIN_PASSWORD=PrismaAdmin2026!

# Retell AI — panel de analítica de agentes de voz (solo admin).
# Opcional: sin key el panel funciona solo-lectura y "Sincronizar" responde 503.
RETELL_API_KEY=
RETELL_BASE_URL=https://api.retellai.com
RETELL_SYNC_LOOKBACK_DAYS=90

# Aware / SOFIA — panel de analítica de inbound Claro (rol `analista`).
# BD PostgreSQL de solo lectura (mismas credenciales que VOICEBOT_DB_* de VoxPro).
AWARE_DB_HOST=asiste.awareccm.com
AWARE_DB_PORT=5432
AWARE_DB_NAME=awareccm
AWARE_DB_USER=analista
AWARE_DB_PASSWORD=
AWARE_AUDIO_BASE_URL=https://asiste.awareccm.com/audiofiles

# Token compartido con VoxPro para el snapshot de calidad IA (rol analista).
VOXPRO_ANALYTICS_TOKEN=
